# ── LiteLLM proxy (OpenAI-compatible) ─────────────────────────────────────────
LITELLM_BASE_URL=http://litellm.dev.v2.cluster.linuxfound.info
LITELLM_API_KEY=sk-...

# Model name as configured in your LiteLLM deployment
LITELLM_MODEL=claude-sonnet-4-6

# ── HubSpot ────────────────────────────────────────────────────────────────────
# Private App token from HubSpot Settings → Integrations → Private Apps
HUBSPOT_API_KEY=pat-na1-...

# ── Snowflake ──────────────────────────────────────────────────────────────────
# Account identifier: orgname-accountname  (no .snowflakecomputing.com suffix)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_DATABASE=ANALYTICS
SNOWFLAKE_SCHEMA=Silver_Segment
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_ROLE=
