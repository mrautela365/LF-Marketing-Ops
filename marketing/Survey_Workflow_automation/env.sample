# Copy this file to ".env" in this same directory and fill in the values you have.
#
# Deterministic LLM gateway backend priority: anthropic -> litellm -> claude CLI
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# LiteLLM proxy (used only if ANTHROPIC_API_KEY is unset)
LITELLM_BASE_URL=
LITELLM_API_KEY=
LITELLM_MODEL=

# Claude CLI fallback (used only if neither key above is set)
CLAUDE_CLI_PATH=

# HubSpot (not used yet -- reserved for the Implementation phase)
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_PORTAL_ID=
