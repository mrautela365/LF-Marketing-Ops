# HubSpot Draft Email MCP Server — Environment Variables
#
# Copy this file to .env and fill in your credentials.
# The server also accepts these as real environment variables (env vars take priority over .env).
#
# Required scopes for the HubSpot Private App:
#   marketing-email, communication-preferences, crm.lists.read, content

# Required
HUBSPOT_API_KEY=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Optional — only needed if using Asana task pre-fill
ASANA_PAT=1/xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional — defaults to 8001
PORT=8001
