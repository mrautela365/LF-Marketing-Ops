# HubSpot Form Manager — Environment Variables
# Copy this file to .env and fill in your credentials.
#
# Credential resolution order:
#   1. Environment variable already set in the shell (highest priority)
#   2. This .env file
#   3. /setup page in the browser (if neither of the above is set)

# ── HubSpot Private App Token (REQUIRED) ─────────────────────────────────────
# Create a Private App in HubSpot → Settings → Integrations → Private Apps
# Required scopes: forms, communication-preferences, automation, crm.lists.read, content
HUBSPOT_API_KEY=

# ── Asana Personal Access Token (OPTIONAL) ───────────────────────────────────
# Only needed for Asana pre-fill. If blank, the Asana tab/feature is disabled.
# Create at: https://app.asana.com/0/my-apps
ASANA_PAT=

# ── Server Port (OPTIONAL, default: 8000) ────────────────────────────────────
PORT=8000
