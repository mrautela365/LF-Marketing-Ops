# Copy this file to .env and fill in your values.
# The .env file lives one level above the backend/ folder (email_service/.env).

# ── HubSpot ────────────────────────────────────────────────────────────────────
HUBSPOT_ACCESS_TOKEN=your-hubspot-private-app-token
HUBSPOT_PORTAL_ID=8112310

# ── Google (for Doc scraping) ──────────────────────────────────────────────────
GOOGLE_SERVICE_ACCOUNT_FILE=/absolute/path/to/service-account.json

# ── Asana ──────────────────────────────────────────────────────────────────────
ASANA_ACCESS_TOKEN=your-asana-token

# ── LiteLLM proxy (optional — falls back to Claude CLI if not set) ─────────────
LITELLM_BASE_URL=
LITELLM_API_KEY=

# ── Skill directory ────────────────────────────────────────────────────────────
# Set this if your hubspot-event-list-builder repo is NOT a sibling of email_service.
# Example (Mac):     SKILL_DIR=/Users/yourname/repos/LF-Marketing-Ops/marketing/hubspot-event-list-builder
# Example (Windows): SKILL_DIR=C:\Users\yourname\repos\LF-Marketing-Ops\marketing\hubspot-event-list-builder
SKILL_DIR=

# ── Snowflake ──────────────────────────────────────────────────────────────────
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PRIVATE_KEY=
SNOWFLAKE_DATABASE=ANALYTICS
SNOWFLAKE_SCHEMA=Silver_Segment
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_ROLE=
