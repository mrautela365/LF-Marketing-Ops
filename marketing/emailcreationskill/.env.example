# Copy to .env and fill in your credentials

# Anthropic — leave blank to use Claude Code CLI (dev mode)
ANTHROPIC_API_KEY=

# HubSpot private app token (needs: content, crm.lists scopes)
HUBSPOT_ACCESS_TOKEN=

# Asana personal access token
ASANA_TOKEN=

# Path to Google service account credentials JSON (for Docs API)
# If blank, Google Doc export falls back to public share link
GOOGLE_CREDENTIALS_PATH=

# HubSpot portal ID (default is Linux Foundation's)
HUBSPOT_PORTAL_ID=8112310
