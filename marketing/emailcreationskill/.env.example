# ─────────────────────────────────────────────────────────────────────────────
# Email Automation / Campaign Builder — environment template
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ─────────────────────────────────────────────────────────────────────────────

# ── AI provider ──────────────────────────────────────────────────────────────
# Direct Anthropic API key (only used if LiteLLM below is NOT configured).
ANTHROPIC_API_KEY=
# Model id used for plan + content generation.
CLAUDE_MODEL=claude-sonnet-4-6

# LiteLLM proxy — takes priority over ANTHROPIC_API_KEY when both are set.
LITELLM_BASE_URL=
LITELLM_API_KEY=
# Optional: override the model sent to LiteLLM (falls back to CLAUDE_MODEL).
LITELLM_MODEL=

# ── HubSpot ──────────────────────────────────────────────────────────────────
# Private app access token (starts with `pat-na1-...`).
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_PORTAL_ID=8112310

# ── Google (for staging content from Google Docs) ────────────────────────────
# Absolute path to a service-account JSON key file.
GOOGLE_SERVICE_ACCOUNT_FILE=

# ── Skill / Asana integration (optional) ─────────────────────────────────────
# Shared secret for POST /api/stage-from-brief. Empty = accept calls (local dev).
INTERNAL_API_TOKEN=
# Asana personal access token (only needed for the Asana brief flow).
ASANA_ACCESS_TOKEN=

# ── Snowflake (audience list building) ───────────────────────────────────────
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_ROLE=
SNOWFLAKE_DATABASE=ANALYTICS
SNOWFLAKE_SCHEMA=Silver_Segment
SNOWFLAKE_WAREHOUSE=
# Full PEM private key, including the BEGIN/END lines.
SNOWFLAKE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----
-----END PRIVATE KEY-----